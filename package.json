{
  "name": "portale-casatese",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "crea-utenti": "node --env-file=.env.local scripts/crea-utenti.mjs",
    "typecheck": "tsc --noEmit",
    "deck": "python3 scripts/deck_casatese.py",
    "backup": "node --env-file=.env.local scripts/backup.mjs",
    "manuali": "python3 scripts/manuali/genera.py && node scripts/manuali/stampa.mjs",
    "prove:portale": "node scripts/prove-portale.mjs",
    "prove": "npm run lint && npm run typecheck && npm run prove:regole && npm run prove:portale && npm run build",
    "prove:regole": "node --import ./tests/registra.mjs --test 'tests/*.test.mjs'"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "jspdf": "^3.0.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "description": "Academy Casatese Merate: portale delle squadre (rosa, gare, allenamenti, famiglie, segreteria) e Scouting Hub"
}
